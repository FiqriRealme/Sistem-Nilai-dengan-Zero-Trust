# Salin file ini menjadi .env, lalu isi rahasia lokal sebelum menjalankan aplikasi.
NODE_ENV=development
JWT_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter
GATEWAY_SECRET=ganti-dengan-rahasia-internal-acak
SERVICE_CLIENT_ID=service-nilai
SERVICE_CLIENT_SECRET=ganti-dengan-rahasia-client-service

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zero_trust_nilai

GATEWAY_PORT=3000
SERVICE_NILAI_PORT=3001
SERVICE_TRANSKRIP_PORT=3002
ACCESS_WINDOW_START=07:00
ACCESS_WINDOW_END=21:00
TIME_ZONE=Asia/Jakarta
